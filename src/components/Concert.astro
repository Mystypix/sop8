---
import { concertDateKey, formatConcertDate } from '../utils/concertDate';
import { nonNullItems } from '../utils/collections';
const { concert, isFuture } = Astro.props;
const {
    address,
    agenda = [],
    conductor,
    date,
    description,
    invitation,
    price,
    solists,
    time,
} = concert;
// Tina can return null for an unset optional list, even when the schema
// describes it as a list. Keep older or partially edited concerts renderable.
const concertAgenda = nonNullItems(agenda);
const hasText = (value?: string | null) => Boolean(value?.trim());
---

<div class=`concert  ${isFuture ? 'future' : ''}` data-concert-date={concertDateKey(date)} data-concert-time={time}>
    {concertAgenda.some(({ composer, composition }) => hasText(composer) || hasText(composition)) && (
        <div class="agenda">
            {concertAgenda.map(({ composition, composer }) => (hasText(composer) || hasText(composition)) && (
                <div class="agendaItem">
                    {hasText(composer) && <div class="composer">{composer}</div>}
                    {hasText(composition) && <div class="composition">{composition}</div>}
                </div>
            ))}
        </div>
    )}
    {hasText(date) && <div class="date"><strong>Datum: </strong>{formatConcertDate(date)}</div>}
    {
        isFuture && hasText(time) && (
            <div class="time future-only">
                <strong>Čas: </strong>
                {time}
            </div>
        )
    }
    {hasText(address) && <div class="place"><strong>Adresa: </strong>{address}</div>}
    {
        isFuture && hasText(conductor) && (
            <div class="future-only">
                <strong>Dirigent: </strong>
                {conductor}
            </div>
        )
    }
    {
        isFuture && hasText(solists) && (
            <div class="future-only">
                <strong>Sólisté: </strong>
                {solists}
            </div>
        )
    }
    {
        isFuture && hasText(price) && (
            <div class="future-only">
                <strong>Cena: </strong>
                {price} Kč
            </div>
        )
    }
    {hasText(description) && <div class="program">{description}</div>}
    {
        hasText(invitation) && (
            <a href={invitation} target="_blank">
                Pozvánka
            </a>
        )
    }
</div>
<style>
    .concert {
        margin: 0 auto;
        max-width: 800px;
        border-left: 2px solid var(--main-color);
        padding: 20px;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
        background: #f2f2f2;

        * {
            font-size: 16px;
        }

        + .concert {
            margin-top: 20px;
        }

        &.future {
            background: #fff;
        }

        &:not(.future) .future-only { display: none; }

        > div {
            margin-top: 5px;
        }
    }

    .agenda {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 40px;
        margin-bottom: 20px;
    }

    .date,
    .time {
        display: inline-block;
    }

    .time {
        margin-left: 10px;
    }

    .agendaItem {
        margin-top: 0 !important;
    }

    .composer {
        font-size: 20px;
        font-weight: 600;
    }

    .composition {
        font-size: 16px;
        font-weight: 600;
    }
</style>
