---
import { client } from '../../tina/__generated__/client'
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
const data = await client.queries.contact({ relativePath: 'contact.md' })
---
<Layout title="SOP8 - Kontakty" description="Kontaktujte Symfonický orchestr Prahy 8 a zjistěte, kde a kdy probíhají zkoušky.">
    <Section title="Kontakty">
        <div class="wrapper">
            <div>
                <div>
                    <strong>Orchestrální e-mail: </strong><a href={`mailto:${data.data.contact.email}`}>{data.data.contact.email}</a>
                </div>
                <div>
                    <strong>Vedoucí orchestru: </strong>{data.data.contact.leadership.name}
                </div>
                <div>
                    <strong>Email: </strong><a href=`mailto:${data.data.contact.leadership.email}`>{data.data.contact.leadership.email}</a>
                </div>
                <div>
                    <strong>Telefon: </strong><a href=`tel:${data.data.contact.leadership.phone}`>{data.data.contact.leadership.phone}</a>
                </div>
            </div>
            <div>
                <strong>Kde hrajeme</strong>
                <p>{data.data.contact.practice.text}</p>
                <p>{data.data.contact.practice.address}</p>
                <a class="mapLink" href="https://mapy.com/s/defapavako" target="_blank" rel="noreferrer">
                    Otevřít místo zkoušek na mapě
                </a>
            </div>
        </div>
        <iframe
            class="map"
            src="https://frame.mapy.cz/s/defapavako"
            title="Mapa místa zkoušek v Gymnáziu Christiana Dopplera"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
        ></iframe>
    </Section>
</Layout>
<style>
    .wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .map {
        margin-top: 30px;
        width: 100%;
        min-height: 400px;
        border: 0;
        background: #f2f2f2;
    }

    .mapLink {
        display: inline-block;
        margin-top: 8px;
    }

    @media (max-width: 768px) {
        .wrapper {
            grid-template-columns: 1fr;
        }

        .map {
            min-height: 320px;
        }
    }
</style>
