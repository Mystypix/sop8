---
import { client } from "../../tina/__generated__/client";
import { TinaMarkdown } from "tinacms/dist/rich-text";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Concert from "../components/Concert.astro";
import { concertDateKey, pragueNowKey } from "../utils/concertDate";
import { nonNullItems } from "../utils/collections";
const homepageData = await client.queries.homepage({
  relativePath: "homepage.md",
});
const concertData = await client.queries.concerts({
  relativePath: "concerts.md",
});
const concerts = nonNullItems(concertData.data.concerts.concerts)
  .filter((concert) => concert.date && !Number.isNaN(Date.parse(concert.date)));
const futureConcerts = concerts
  .filter(({ date }) => concertDateKey(date) >= pragueNowKey().slice(0, 10))
  .sort((a, b) => concertDateKey(a.date).localeCompare(concertDateKey(b.date)));
---

<Layout title="SOP8 - Symfonický orchestr Prahy 8" description="Symfonický orchestr Prahy 8 tvoří studenti a mladí pracující. Podívejte se na naše koncerty nebo se k nám přidejte.">
  <Section className="section--intro">
    <div class="introText">
      <TinaMarkdown content={homepageData.data.homepage.introText} />
    </div>
  </Section>
  <div class="joinUs">
    <h2 class="title">Přidejte se k nám!</h2>
    <div class="joinUsText"><TinaMarkdown content={homepageData.data.homepage.joinUsText} /></div>
  </div>
  {
    futureConcerts.length ? (
      <Section className="introConcerts">
        <div class="concertSection">
          <h2 class="introConcertTitle">Nadcházející koncerty</h2>
          {futureConcerts.map((concert) => (
            <Concert isFuture concert={concert} />
          ))}
        </div>
      </Section>
    ) : null
  }
</Layout>
<script>
  import { pragueNowKey } from "../utils/concertDate";

  const removePastHomepageConcerts = () => {
    const now = pragueNowKey();
    document.querySelectorAll<HTMLElement>('.introConcerts [data-concert-date]').forEach((card) => {
      const date = card.dataset.concertDate ?? '';
      const time = (card.dataset.concertTime ?? '00:00').slice(0, 5);
      if (`${date}T${time}` <= now) card.remove();
    });
    const section = document.querySelector<HTMLElement>('.introConcerts');
    if (section) section.hidden = !section.querySelector('[data-concert-date]');
  };
  removePastHomepageConcerts();
  window.setInterval(removePastHomepageConcerts, 60_000);
</script>
<style>
  .introText {
    margin: 0 auto;
    max-width: 900px;

    * {
      font-size: 30px;
      text-align: center;
      color: #fff;
      text-shadow: 0 0 15px rgba(0, 0, 0, 1);
      font-weight: 900;
      line-height: 45px;
    }
  }

  .joinUs {
	margin: 0 auto;
	padding: 40px 20px;
    max-width: 900px;

	.title {
		font-size: 30px;
		margin-bottom: 20px;
	}

	* {
		text-align: center;
	}
}

  .joinUsText :global(p) {
    margin: 0;
  }

  .introConcertTitle {
    margin-bottom: 40px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .introText {
      * {
        font-size: 20px;
        line-height: 30px;
      }
    }
  }
</style>
