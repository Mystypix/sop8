---
    import { client } from '../../tina/__generated__/client'
    import Layout from "../layouts/Layout.astro";
    import Section from "../components/Section.astro";
    import Concert from "../components/Concert.astro";
    const data = await client.queries.concerts({ relativePath: 'concerts.md' })
    const futureConcerts = data.data.concerts.concerts
        .filter(({date}) => new Date(date) > new Date())
        .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
    const pastConcerts = data.data.concerts.concerts.filter(({date}) => new Date(date) < new Date());
---
<Layout title="SOP8 - Koncerty">
    <Section title="Koncerty">
        <div class="concertSection upcomingConcerts" hidden={!futureConcerts.length}>
                <h2 class="title">Nadcházející koncerty</h2>
                {futureConcerts.map((concert) => <Concert isFuture concert={concert} />)}
        </div>
        <div class="concertSection pastConcerts">
            <h2 class="title">Odehrané koncerty</h2>
            {pastConcerts.map((concert) => <Concert concert={concert} />)}
        </div>
    </Section>
</Layout>
<script>
    const updateConcertSections = () => {
        const upcoming = document.querySelector<HTMLElement>('.upcomingConcerts');
        const past = document.querySelector<HTMLElement>('.pastConcerts');
        if (!upcoming || !past) return;

        const cards = [...document.querySelectorAll<HTMLElement>('[data-concert-date]')];
        const now = new Date();
        const getStart = (card: HTMLElement) => {
            const [year, month, day] = (card.dataset.concertDate ?? '').slice(0, 10).split('-').map(Number);
            const [hours = 0, minutes = 0] = (card.dataset.concertTime ?? '').split(':').map(Number);
            return new Date(year, month - 1, day, hours, minutes).getTime();
        };

        const futureCards = cards.filter((card) => getStart(card) > now.getTime())
            .sort((a, b) => getStart(a) - getStart(b));
        const pastCards = cards.filter((card) => getStart(card) <= now.getTime())
            .sort((a, b) => getStart(b) - getStart(a));
        upcoming.querySelectorAll('.yearTitle').forEach((heading) => heading.remove());
        past.querySelectorAll('.yearTitle').forEach((heading) => heading.remove());
        futureCards.forEach((card) => {
            card.classList.add('future');
            upcoming.append(card);
        });
        pastCards.forEach((card) => {
            card.classList.remove('future');
            past.append(card);
        });
        upcoming.hidden = futureCards.length === 0;
        for (const card of pastCards) {
            const year = new Date(getStart(card)).getFullYear();
            const previousCard = card.previousElementSibling?.matches('[data-concert-date]')
                ? card.previousElementSibling as HTMLElement
                : null;
            if (!previousCard || new Date(getStart(previousCard)).getFullYear() !== year) {
                const heading = document.createElement('h3');
                heading.className = 'yearTitle';
                heading.textContent = String(year);
                past.insertBefore(heading, card);
            }
        }
    };

    updateConcertSections();
    window.setInterval(updateConcertSections, 60_000);
</script>
<style>
    .title {
        margin-bottom: 20px;
        font-size: 24px;
        text-align: center;
        font-weight: 500;
    }

    .yearTitle {
        margin-top: 40px;
        margin-bottom: 20px;
        font-size: 20px;
        text-align: center;
        font-weight: 500;
    }

    .concertSection {
        + .concertSection {
            margin-top: 40px;
        }
    }
</style>
