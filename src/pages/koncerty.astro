---
    import { client } from '../../tina/__generated__/client'
    import Layout from "../layouts/Layout.astro";
    import Section from "../components/Section.astro";
    import Concert from "../components/Concert.astro";
    const data = await client.queries.concerts({ relativePath: 'concerts.md' })
    const futureConcerts = data.data.concerts.concerts
        .filter(({date}) => new Date(date) > new Date())
        .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
    const pastConcerts = data.data.concerts.concerts.filter(({date}) => new Date(date) < new Date());
---
<Layout title="SOP8 - Koncerty" description="Program a termíny nadcházejících koncertů Symfonického orchestru Prahy 8 i archiv odehraných koncertů.">
    <Section title="Koncerty">
        <div class="concertSection upcomingConcerts" hidden={!futureConcerts.length}>
                <h2 class="title">Nadcházející koncerty</h2>
                {futureConcerts.map((concert) => <Concert isFuture concert={concert} />)}
        </div>
        <div class="concertSection pastConcerts">
            <h2 class="title">Odehrané koncerty</h2>
            <div class="pastConcertYears">
                {pastConcerts.map((concert) => <Concert concert={concert} />)}
            </div>
        </div>
    </Section>
</Layout>
<script>
    const updateConcertSections = () => {
        const upcoming = document.querySelector<HTMLElement>('.upcomingConcerts');
        const past = document.querySelector<HTMLElement>('.pastConcerts');
        const yearContainer = past?.querySelector<HTMLElement>('.pastConcertYears');
        if (!upcoming || !past || !yearContainer) return;

        const cards = [...document.querySelectorAll<HTMLElement>('[data-concert-date]')];
        const now = new Date();
        const getStart = (card: HTMLElement) => {
            const [year, month, day] = (card.dataset.concertDate ?? '').slice(0, 10).split('-').map(Number);
            const [hours = 0, minutes = 0] = (card.dataset.concertTime ?? '').split(':').map(Number);
            return new Date(year, month - 1, day, hours, minutes).getTime();
        };

        const futureCards = cards.filter((card) => getStart(card) > now.getTime())
            .sort((a, b) => getStart(a) - getStart(b));
        const pastCards = cards.filter((card) => getStart(card) <= now.getTime())
            .sort((a, b) => getStart(b) - getStart(a));
        const hasUpdatedOnce = yearContainer.dataset.initialized === 'true';
        const needsUpdate = cards.some((card) => card.classList.contains('future') !== (getStart(card) > now.getTime()));
        if (hasUpdatedOnce && !needsUpdate) return;

        const previouslyOpenYears = new Set(
            [...yearContainer.querySelectorAll<HTMLDetailsElement>('details[open]')]
                .map((group) => group.dataset.year)
        );
        futureCards.forEach((card) => {
            card.classList.add('future');
            upcoming.append(card);
        });
        upcoming.hidden = futureCards.length === 0;

        const pastByYear = new Map<number, HTMLElement[]>();
        for (const card of pastCards) {
            card.classList.remove('future');
            const year = new Date(getStart(card)).getFullYear();
            const concerts = pastByYear.get(year) ?? [];
            concerts.push(card);
            pastByYear.set(year, concerts);
        }

        yearContainer.replaceChildren();
        [...pastByYear.entries()].forEach(([year, concerts], index) => {
            const group = document.createElement('details');
            group.className = 'yearGroup';
            group.dataset.year = String(year);
            group.open = previouslyOpenYears.has(String(year)) || (!hasUpdatedOnce && index === 0);

            const summary = document.createElement('summary');
            summary.className = 'yearSummary';
            summary.textContent = `${year} · ${concerts.length} ${concerts.length === 1 ? 'koncert' : concerts.length < 5 ? 'koncerty' : 'koncertů'}`;

            const concertList = document.createElement('div');
            concertList.className = 'concertYearItems';
            concerts.forEach((card) => concertList.append(card));
            group.append(summary, concertList);
            yearContainer.append(group);
        });
        yearContainer.dataset.initialized = 'true';
        past.hidden = pastCards.length === 0;
    };

    updateConcertSections();
    window.setInterval(updateConcertSections, 60_000);
</script>
<style>
    .title {
        margin-bottom: 20px;
        font-size: 24px;
        text-align: center;
        font-weight: 500;
    }

    .yearGroup {
        margin-top: 12px;
        border: 1px solid rgba(0, 0, 0, 0.12);
        background: rgba(255, 255, 255, 0.45);
    }

    .yearSummary {
        padding: 12px 16px;
        font-size: 20px;
        font-weight: 600;
        cursor: pointer;
    }

    .yearSummary:focus-visible {
        outline: 3px solid var(--main-color);
        outline-offset: 2px;
    }

    .concertYearItems {
        padding: 0 12px 16px;
    }

    .concertSection + .concertSection {
        margin-top: 40px;
    }
</style>
