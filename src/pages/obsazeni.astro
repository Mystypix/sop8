---
import { client } from '../../tina/__generated__/client'
import Layout from "../layouts/Layout.astro"
import Section from "../components/Section.astro";
const data = await client.queries.structure({ relativePath: 'structure.md' })
const {
    basses,
    bassoons,
    clarinets,
    drums,
    first_violins,
    flutes,
    french_horns,
    oboes,
    second_violins,
    trombones,
    trumpets,
    violoncellos,
    viols,
} = data.data.structure
---
<Layout title="SOP8 - Obsazení" description="Poznejte nástrojové sekce a členy Symfonického orchestru Prahy 8.">
    <Section title="Obsazení">
        <div class="grid">
            <div class="grid-item section section--violins">
                <strong>I. housle</strong>
                {first_violins.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--violins">
                <strong>II. housle</strong>
                {second_violins.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--viols">
                <strong>Violy</strong>
                {viols.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--cellos">
                <strong>Violoncella</strong>
                {violoncellos.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--basses">
                <strong>Kontrabasy</strong>
                {basses.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--flutes">
                <strong>Flétny</strong>
                {flutes.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--bassoons">
                <strong>Fagoty</strong>
                {bassoons.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--clarinets">
                <strong>Klarinety</strong>
                {clarinets.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--trumpets">
                <strong>Trubky</strong>
                {trumpets.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--oboes">
                <strong>Hoboje</strong>
                {oboes.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--french-horns">
                <strong>Lesní rohy</strong>
                {french_horns.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--trombones">
                <strong>Trombóny</strong>
                {trombones.map(({name}) => <div class="person">{name}</div>)}
            </div>
            <div class="grid-item section section--drums">
                <strong>Bicí/tympán</strong>
                {drums.map(({name}) => <div class="person">{name}</div>)}
            </div>
        </div>
    </Section>
</Layout>
<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .grid-item {
        position: relative;
        border-left: 2px solid var(--main-color);
        padding: 30px;
        min-height: 300px;
        background: #fff;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);

        &::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.2;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center center;
        }

        strong {
            display: block;
            margin-bottom: 10px;
        }
    }

    .section--viols {
        &::before {
            background-image: url("../assets/viola.webp");
        }
    }

    .section--violins {
        &::before {
            background-image: url("../assets/housle.webp");
        }
    }


    .section--cellos {
        &::before {
            background-image: url("../assets/cello.webp");
        }
    }

    .section--basses {
        &::before {
            background-image: url("../assets/basa.webp");
        }
    }

    .section--flutes {
        &::before {
            background-image: url("../assets/fletna.webp");
        }
    }

    .section--bassoons {
        &::before {
            background-image: url("../assets/fagot.webp");
        }
    }

    .section--clarinets {
        &::before {
            background-image: url("../assets/klarinet.webp");
        }
    }

    .section--trumpets {
        &::before {
            background-image: url("../assets/trubka.webp");
        }
    }


    .section--oboes {
        &::before {
            background-image: url("../assets/hoboj.webp");
        }
    }

    .section--french-horns {
        &::before {
            background-image: url("../assets/horna.webp");
        }
    }

    .section--trombones {
        &::before {
            background-image: url("../assets/trombon.webp");
        }
    }

    .section--drums {
        &::before {
            background-image: url("../assets/bici.webp");
        }
    }

    .person {
        font-weight: 500;
    }

    @media (max-width: 1100px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 700px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
