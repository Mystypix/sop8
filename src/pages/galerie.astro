---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Section from "../components/Section.astro";

const assets = await getCollection("assets");
const galleryDict: Record<string, string[]> = {};

for (const item of assets) {
  const galleryName = item.id.split("/")[1];
  if (!galleryName) continue;
  (galleryDict[galleryName] ??= []).push(item.data.url);
}

const sections = Object.entries(galleryDict)
  .map(([name, images]) => ({ name, images }))
  .sort((a, b) => {
    const [dayA, monthA, yearA] = a.name.split("-")[0].trim().split(".").map((part) => part.trim());
    const [dayB, monthB, yearB] = b.name.split("-")[0].trim().split(".").map((part) => part.trim());
    return new Date(`${yearB}-${monthB}-${dayB}`).getTime() - new Date(`${yearA}-${monthA}-${dayA}`).getTime();
  });
---

<Layout title="SOP8 - Galerie" description="Fotografie z koncertů a dalších akcí Symfonického orchestru Prahy 8.">
  <Section title="Galerie">
    {sections.map(({ name, images }, sectionIndex) => {
      const galleryId = `galerie-${sectionIndex}`;
      const hiddenCount = Math.max(0, images.length - 5);

      return (
        <section class="gallerySection" aria-labelledby={`${galleryId}-title`}>
          <h2 id={`${galleryId}-title`} class="sectionTitle">{name}</h2>
          <div class="gallery" id={galleryId}>
            {images.map((image, index) => (
              <a
                class="glightbox"
                href={image}
                data-gallery={galleryId}
                data-title={name}
                aria-label={`${name}, fotografie ${index + 1}`}
                hidden={index >= 5}
              >
                <Image
                  class="img"
                  src={image}
                  alt={`${name}, fotografie ${index + 1}`}
                  width={240}
                  height={200}
                  loading={sectionIndex === 0 && index === 0 ? "eager" : "lazy"}
                  fetchpriority={sectionIndex === 0 && index === 0 ? "high" : "auto"}
                  decoding="async"
                  quality={75}
                />
              </a>
            ))}
          </div>
          {hiddenCount > 0 && (
            <button class="showMore" type="button" aria-expanded="false" aria-controls={galleryId}>
              Zobrazit dalších {hiddenCount} fotografií
            </button>
          )}
        </section>
      );
    })}
  </Section>
</Layout>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  GLightbox({
    selector: ".glightbox",
    zoomable: false,
    touchNavigation: true,
    loop: true,
  });

  document.querySelectorAll<HTMLButtonElement>(".showMore").forEach((button) => {
    const gallery = document.getElementById(button.getAttribute("aria-controls") ?? "");
    if (!gallery) return;

    const images = [...gallery.querySelectorAll<HTMLAnchorElement>(".glightbox")];
    const hiddenCount = images.filter((image) => image.hidden).length;
    button.addEventListener("click", () => {
      const expanded = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(expanded));
      images.forEach((image, index) => {
        image.hidden = !expanded && index >= 5;
      });
      button.textContent = expanded
        ? "Zobrazit méně"
        : `Zobrazit dalších ${hiddenCount} fotografií`;
    });
  });
</script>

<style>
  .gallerySection + .gallerySection {
    margin-top: 60px;
  }

  .sectionTitle {
    margin-bottom: 20px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
    width: 100%;
  }

  .glightbox {
    display: block;
    height: 200px;
    overflow: hidden;
  }

  .glightbox[hidden] {
    display: none;
  }

  .img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (hover: hover) {
    .img:hover {
      transform: scale(1.05);
    }
  }

  .showMore {
    display: block;
    margin: 20px auto 0;
    padding: 8px 16px;
    border: 1px solid var(--main-color);
    border-radius: 4px;
    background: transparent;
    color: var(--main-color);
    font: inherit;
    cursor: pointer;
  }

  .showMore:hover {
    background: var(--main-color);
    color: #fff;
  }

  .showMore:focus-visible {
    outline: 3px solid var(--text-color);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .glightbox {
      height: auto;
      aspect-ratio: 6 / 5;
    }
  }
</style>
